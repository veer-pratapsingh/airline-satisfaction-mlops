# SERVER profile for Feast (used by the GitLab CI/CD pipeline).
#
# The CI job copies this over feature_store.yaml when running on the server:
#     cp feature_store.yaml.server feature_store.yaml
#
# Storage layout on the server (all on Garage via s3_endpoint_override):
#   - registry on s3://feast (boto3 honours the override here)
#   - offline feature parquets on s3://feast, saved dataset on s3://datasets
#     (FileSource / SavedDatasetFileStorage each carry s3_endpoint_override)
#   - online store is Postgres (the FEAST/Postgres service) for real serving
project: rested_liger
provider: local

registry:
    registry_type: file
    path: s3://feast/registry.db
    s3_endpoint_override: http://garage:3900

online_store:
    type: postgres
    host: ${POSTGRES_FEAST_HOST}
    port: ${POSTGRES_FEAST_PORT}
    database: ${POSTGRES_FEAST_DB}
    db_schema: public
    user: ${POSTGRES_FEAST_USER}
    password: ${POSTGRES_FEAST_PASSWORD}
    sslmode: disable

offline_store:
    type: file

entity_key_serialization_version: 3
auth:
    type: no_auth
