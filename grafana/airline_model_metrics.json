{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select your Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["mlops", "airline", "model-metrics"],
  "title": "Airline Satisfaction - Model Metrics",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(model_roc_auc, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Best ROC-AUC",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "max(model_roc_auc)", "instant": true, "legendFormat": "best AUC" }
      ]
    },
    {
      "type": "stat",
      "title": "Best model (by ROC-AUC)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "none",
        "textMode": "name"
      },
      "targets": [
        { "refId": "A", "expr": "topk(1, model_roc_auc)", "instant": true, "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Models evaluated",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "count(model_roc_auc)", "instant": true, "legendFormat": "models" }
      ]
    },
    {
      "type": "stat",
      "title": "Best Accuracy",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 4 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "max(model_accuracy)", "instant": true, "legendFormat": "best accuracy" }
      ]
    },
    {
      "type": "bargauge",
      "title": "ROC-AUC by model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "model_roc_auc{model=~\"$model\"}", "instant": true, "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Accuracy by model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 4, "min": 0, "max": 1 }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "model_accuracy{model=~\"$model\"}", "instant": true, "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "bargauge",
      "title": "F1 by model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 4, "min": 0, "max": 1 }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "model_f1{model=~\"$model\"}", "instant": true, "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "table",
      "title": "All metrics by model (latest)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 4 } },
      "targets": [
        { "refId": "A", "expr": "model_accuracy{model=~\"$model\"}", "instant": true, "format": "table" },
        { "refId": "B", "expr": "model_precision{model=~\"$model\"}", "instant": true, "format": "table" },
        { "refId": "C", "expr": "model_recall{model=~\"$model\"}", "instant": true, "format": "table" },
        { "refId": "D", "expr": "model_f1{model=~\"$model\"}", "instant": true, "format": "table" },
        { "refId": "E", "expr": "model_roc_auc{model=~\"$model\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "pattern": "^(model|Value)$" } } },
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "model": "Model",
              "Value #A": "Accuracy",
              "Value #B": "Precision",
              "Value #C": "Recall",
              "Value #D": "F1",
              "Value #E": "ROC-AUC"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "ROC-AUC", "desc": true }] } }
      ]
    },
    {
      "type": "timeseries",
      "title": "ROC-AUC over time (all models)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "pointSize": 6, "showPoints": "always", "spanNulls": true }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        { "refId": "A", "expr": "model_roc_auc{model=~\"$model\"}", "legendFormat": "{{model}}" }
      ]
    }
  ]
}
